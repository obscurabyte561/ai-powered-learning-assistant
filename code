app_code = r'''import os
import streamlit as st
from google import genai
from google.genai import types

st.set_page_config(
    page_title="LearnMate AI | Learning Assistant",
    page_icon="🎓",
    layout="wide",
)

st.markdown("""
<style>
    .main {background: #f7f9fc;}
    .hero {
        padding: 1.5rem 1.7rem;
        border-radius: 18px;
        background: linear-gradient(120deg, #e8f1ff, #f4eaff);
        border: 1px solid #d9e5f5;
        margin-bottom: 1rem;
    }
    .hero h1 {margin: 0; color: #17365d;}
    .hero p {margin: .45rem 0 0; color: #43556b;}
    .small-note {color: #607086; font-size: .9rem;}
</style>
""", unsafe_allow_html=True)

st.markdown("""
<div class="hero">
  <h1>🎓 LearnMate AI</h1>
  <p>Your friendly AI learning assistant — ask questions, understand topics, revise, and practise.</p>
</div>
""", unsafe_allow_html=True)

with st.sidebar:
    st.header("Learning tools")
    mode = st.radio(
        "Choose what you need",
        ["Ask a question", "Explain a topic", "Make a summary", "Create a quiz"],
    )
    level = st.selectbox("Explanation level", ["Beginner", "School student", "College student"])
    subject = st.text_input("Subject (optional)", placeholder="e.g. Python, Biology, Mathematics")
    st.divider()
    st.caption("Project: AI-Powered Learning Assistant")
    st.caption("SDG 4 — Quality Education")
    st.caption("Created by Vaishnavi Kolekar")

def get_api_key():
    # Streamlit Community Cloud secrets are preferred for deployment.
    try:
        secret_key = st.secrets.get("GEMINI_API_KEY", "")
    except Exception:
        secret_key = ""
    return secret_key or os.getenv("GEMINI_API_KEY", "")

api_key = get_api_key()
if not api_key:
    st.warning("Gemini API key not found. Add GEMINI_API_KEY to your .env file or Streamlit secrets.")
    st.code("GEMINI_API_KEY=your_api_key_here", language="bash")
    st.info("Keep your API key private. Do not paste it into the app code or upload it to GitHub.")
    st.stop()

client = genai.Client(api_key=api_key)

PROMPTS = {
    "Ask a question": (
        "Answer the student's question accurately and clearly. Use simple language, "
        "short sections and an example when useful. If the question is unclear, ask one "
        "brief clarifying question. Do not pretend to know facts you are unsure about."
    ),
    "Explain a topic": (
        "Teach the requested topic to the student. Start with a simple definition, "
        "then explain the main idea step by step, give one everyday example, and finish "
        "with three key points to remember."
    ),
    "Make a summary": (
        "Create concise study notes for the requested topic. Use a short introduction, "
        "important points, key terms and a brief final recap. Do not add unsupported facts."
    ),
    "Create a quiz": (
        "Create five beginner-friendly multiple-choice questions about the requested topic. "
        "Give four options for each question. Put the answer key and a one-line explanation "
        "after all five questions."
    ),
}

def generate_response(user_text, chat_history):
    context = f"Student level: {level}. Subject: {subject or 'Not specified'}.\n"
    context += PROMPTS[mode] + "\n\n"
    context += "Conversation so far:\n"
    for item in chat_history[-8:]:
        role = "Student" if item["role"] == "user" else "Tutor"
        context += f"{role}: {item['content']}\n"
    context += f"\nStudent's latest request: {user_text}\n"
    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=context,
        config=types.GenerateContentConfig(
            temperature=0.4,
            max_output_tokens=1200,
        ),
    )
    return response.text or "I couldn't generate a response. Please try asking in a different way."

if "messages" not in st.session_state:
    st.session_state.messages = []

left, right = st.columns([3, 1])
with left:
    st.subheader("Your learning space")
with right:
    if st.button("Clear conversation", use_container_width=True):
        st.session_state.messages = []
        st.rerun()

for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

placeholder = {
    "Ask a question": "e.g. Explain the difference between a list and a tuple in Python.",
    "Explain a topic": "e.g. Explain supervised learning with a simple example.",
    "Make a summary": "e.g. Make revision notes on artificial neural networks.",
    "Create a quiz": "e.g. Create a quiz on Python loops.",
}[mode]

user_input = st.chat_input(placeholder)
if user_input:
    st.session_state.messages.append({"role": "user", "content": user_input})
    with st.chat_message("user"):
        st.markdown(user_input)

    with st.chat_message("assistant"):
        with st.spinner("Preparing your learning response..."):
            try:
                answer = generate_response(user_input, st.session_state.messages[:-1])
            except Exception as error:
                answer = (
                    "Sorry, I couldn't reach the AI service. Check your internet connection "
                    "and API key, then try again. Technical detail: " + str(error)
                )
            st.markdown(answer)
    st.session_state.messages.append({"role": "assistant", "content": answer})

st.markdown("---")
st.markdown(
    '<p class="small-note">LearnMate AI is an educational support tool. '
    'Check important information with your teachers or trusted learning materials.</p>',
    unsafe_allow_html=True,
)
'''
